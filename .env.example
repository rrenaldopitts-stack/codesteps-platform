# Optional: leave blank to use local SQLite in .data/codesteps.db.
# Put your Neon/PostgreSQL connection string in git-ignored .env.local.
# Server-side only: never prefix with NEXT_PUBLIC_. Remote TLS certificates are
# always verified; connection-string SSL overrides are ignored. Only loopback
# hosts use plaintext. Existing app tables in public are reused; on a new database
# the role needs permission to create the app tables in public.
# Switching backends does not copy data. Invalid PostgreSQL settings never fall back.
DATABASE_URL=

# Optional: SQLite directory override; use a durable volume in production.
CODESTEPS_DATA_DIR=

# Optional: server-side only. Leave blank for local guidance and course creation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
