# Required: Neon PostgreSQL connection string (server-side only; never prefix with NEXT_PUBLIC_).
# Put the real value in .env.local, which is git-ignored.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Optional: server-side only. Leave blank for local guidance and course creation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
